# 后端大模型服务商配置（支持在 Web 界面右上角「大模型 API 配置」弹窗中一键切换并同步写入）
# 可选值: deepseek | qwen | zhipu | kimi | siliconflow | openai | ollama | custom
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-api-key

# 各厂商独立 API Key（按需配置，切换厂商时自动读取对应环境变量）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
